# Copy this file to .env.watch in the project root and fill in real values.
# .env.watch must be gitignored — it contains a SECRET connection string.

# Neon pooler connection string. Server-only — never prefix with VITE_.
DATABASE_URL=postgres://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Optional: absolute path to the folder you'll drop files into.
# Defaults to ./incoming-reports if not set.
WATCH_FOLDER=C:\path\to\watch\folder
