# Copy this file to .env.watch in the project root and fill in real values.
# .env.watch must be gitignored — it contains a SECRET key.

# Same project URL as your app's VITE_SUPABASE_URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase Dashboard -> Project Settings -> API -> service_role key
# This key BYPASSES Row Level Security entirely. Never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: absolute path to the folder you'll drop files into.
# Defaults to ./incoming-reports if not set.
WATCH_FOLDER=C:\path\to\watch\folder
