# Server-only — never prefix these with VITE_. Vite inlines VITE_* into the public bundle.
# These are read at runtime by /api handlers, not baked in at build time.

DATABASE_URL=postgres://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=salt:hex
SESSION_SECRET=generate-with-openssl-rand-base64-32
